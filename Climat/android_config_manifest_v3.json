  "temperature_constraints": [
    "all temperature hyst >0",
    "168<=heat2_on<=heat1_on",
    "heat2_on+heat2_hyst<=heat1_on+heat1_hyst",
    "cool1_on<=cool2_on<=2000",
    "cool1_on-cool1_hyst<=cool2_on-cool2_hyst",
    "heat1_on+heat1_hyst<cool1_on-cool1_hyst"
  ],
  "rate_constraints": [
    "R=0 disables rising limit",
    "S=0 disables early cooling demand",
    "R>0 implies H<=R",
    "S>0 implies H<=S",
    "H=0 assertion wins on coincident threshold"
  ],
  "migration": {
    "R": 0,
    "H": 0,
    "heater_min_on_seconds": 30,
    "fan_min_on_seconds": 60
  },
  "legacy_protocol": "Reject v1/v2 with status VERSION=8 in v3 reply; old 23-byte payload in v3 gets BAD_PAYLOAD=1",
